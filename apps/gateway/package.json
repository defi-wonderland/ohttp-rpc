{
  "name": "@ohttp/gateway",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "start:dev": "NODE_ENV=development bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "generate-keys": "bun scripts/generate-keys.ts",
    "validate-config": "bun scripts/validate-config.ts",
    "setup": "bun scripts/setup.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@ohttp/core": "workspace:*",
    "@ohttp/hpke-engine": "workspace:*",
    "@ohttp/shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "bun-types": "^1.1.38"
  }
}

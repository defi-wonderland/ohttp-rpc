# OHTTP Gateway Configuration
# Copy this file to .env and update the values for your deployment

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port for the gateway server to listen on
GATEWAY_PORT=8788

# =============================================================================
# CRYPTOGRAPHIC CONFIGURATION
# =============================================================================

# HPKE seed for key generation (REQUIRED)
# Generate with: openssl rand -base64 32
# SECURITY: Keep this secret and rotate periodically
HPKE_SEED=your-secure-base64url-encoded-32-byte-seed-here

# HPKE cipher suite (default is recommended)
HPKE_SUITE=DHKEM_X25519_HKDF_SHA256+HKDF_SHA256+AES_128_GCM

# =============================================================================
# POLICY CONFIGURATION
# =============================================================================

# Comma-separated list of allowed RPC endpoints
# Only requests to these targets will be forwarded
ALLOWED_TARGETS=https://mainnet.infura.io,https://eth.llamarpc.com,https://rpc.ankr.com/eth

# Comma-separated list of allowed HTTP headers
# Only these headers will be forwarded to prevent deanonymization
ALLOWED_HEADERS=content-type,accept,authorization

# Maximum size of inner request body in bytes (512KB default)
MAX_INNER_BYTES=524288

# =============================================================================
# UPSTREAM CONFIGURATION
# =============================================================================

# Connection timeout for upstream RPC requests (milliseconds)
UPSTREAM_CONNECT_TIMEOUT_MS=3000

# Total timeout for upstream RPC requests (milliseconds)
UPSTREAM_TOTAL_TIMEOUT_MS=15000

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Require TLS for upstream connections (recommended: true)
REQUIRE_TLS_UPSTREAM=true

# Allow HTTP redirects from upstream servers (recommended: false)
ALLOW_REDIRECTS=false

# Date skew tolerance for replay protection (milliseconds)
DATE_SKEW_TOLERANCE_MS=300000

# Enable anti-replay protection (recommended: true)
ENABLE_REPLAY_PROTECTION=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Log inner request/response content (NEVER enable in production)
LOG_INNER_CONTENT=false

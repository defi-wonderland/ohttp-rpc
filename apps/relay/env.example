# OHTTP Relay Configuration
# Copy this file to .env and update the values for your deployment

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port for the relay server to listen on
RELAY_PORT=8787

# =============================================================================
# GATEWAY CONFIGURATION
# =============================================================================

# URL of the OHTTP gateway server (REQUIRED)
# This should be the full URL to the gateway endpoint
GATEWAY_URL=https://your-gateway-domain.com/gateway

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Comma-separated list of allowed origins
# Use "*" for all origins (not recommended for production)
# Use specific domains for better security
ALLOWED_ORIGINS=https://your-app-domain.com,https://localhost:3000

# =============================================================================
# SECURITY LIMITS
# =============================================================================

# Maximum request body size in bytes (1MB default)
MAX_BODY_BYTES=1048576

# Rate limiting: requests per minute per IP
RATE_LIMIT_RPM=60

# =============================================================================
# TIMEOUT CONFIGURATION
# =============================================================================

# Connection timeout for gateway requests (milliseconds)
CONNECT_TIMEOUT_MS=3000

# Total timeout for gateway requests (milliseconds)
TOTAL_TIMEOUT_MS=15000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

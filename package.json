{
  "name": "ohttp-rpc",
  "version": "1.0.0",
  "description": "TypeScript implementation of Oblivious HTTP (OHTTP) for anonymizing blockchain RPC requests",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "keywords": [
    "ohttp",
    "oblivious-http",
    "privacy",
    "blockchain",
    "ethereum",
    "rpc",
    "anonymization",
    "hpke",
    "bhttp",
    "typescript"
  ],
  "author": "OHTTP-RPC Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/ohttp-rpc.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/ohttp-rpc/issues"
  },
  "homepage": "https://github.com/your-org/ohttp-rpc#readme",
  "scripts": {
    "build": "bunx tsc --noEmit",
    "dev:relay": "bun --hot apps/relay/src/index.ts",
    "dev:gateway": "bun --hot apps/gateway/src/index.ts",
    "dev:sdk": "bun --hot packages/sdk/src/dev.ts",
    "test": "bun test",
    "test:silent": "TEST_LOG_LEVEL=silent bun test",
    "test:verbose": "TEST_LOG_LEVEL=info bun test",
    "test:debug": "TEST_LOG_LEVEL=debug bun test",
    "test:e2e": "bun test tests/integration/e2e.test.ts",
    "test:e2e:verbose": "TEST_LOG_LEVEL=info bun test tests/integration/e2e.test.ts",
    "test:performance": "bun test tests/performance/",
    "test:integration": "bun test tests/integration/",
    "test:integration:verbose": "TEST_LOG_LEVEL=info bun test tests/integration/",
    "test:all": "bun test",
    "lint": "bunx eslint .",
    "typecheck": "bunx tsc --noEmit",
    "clean": "find . -name '*.tsbuildinfo' -delete && find . -name 'node_modules' -type d -prune -exec rm -rf {} +",
    "deploy": "bun scripts/deploy.ts",
    "deploy:docker": "bun scripts/deploy.ts --mode docker",
    "deploy:native": "bun scripts/deploy.ts --mode native",
    "setup:gateway": "cd apps/gateway && bun run setup",
    "setup:relay": "cd apps/relay && bun run setup",
    "validate:gateway": "cd apps/gateway && bun run validate-config",
    "validate:relay": "cd apps/relay && bun run validate-config",
    "generate-keys": "bun apps/gateway/scripts/generate-keys.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "bun-types": "^1.1.38",
    "eslint": "^9.15.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.44.1",
    "viem": "^2.37.8",
    "zod": "^3.23.8"
  },
  "dependencies": {
    "wagmi": "^2.0.0"
  }
}

# Docker Compose Environment Variables
# Copy this file to .env and update the values

# =============================================================================
# GATEWAY CONFIGURATION
# =============================================================================

# Gateway server port (host mapping)
GATEWAY_PORT=8788

# HPKE seed for gateway (REQUIRED - generate with: bun apps/gateway/scripts/generate-keys.ts)
GATEWAY_HPKE_SEED=your-secure-base64url-encoded-32-byte-seed-here

# HPKE cipher suite
GATEWAY_HPKE_SUITE=DHKEM_X25519_HKDF_SHA256+HKDF_SHA256+AES_128_GCM

# Allowed RPC targets (comma-separated)
GATEWAY_ALLOWED_TARGETS=https://mainnet.infura.io,https://eth.llamarpc.com,https://rpc.ankr.com/eth

# Allowed headers (comma-separated)
GATEWAY_ALLOWED_HEADERS=content-type,accept,authorization

# Maximum request size (bytes)
GATEWAY_MAX_INNER_BYTES=524288

# Timeouts (milliseconds)
GATEWAY_CONNECT_TIMEOUT=3000
GATEWAY_TOTAL_TIMEOUT=15000

# Security settings
GATEWAY_REQUIRE_TLS=true
GATEWAY_ALLOW_REDIRECTS=false
GATEWAY_DATE_SKEW=300000
GATEWAY_REPLAY_PROTECTION=true

# Logging
GATEWAY_LOG_LEVEL=info

# =============================================================================
# RELAY CONFIGURATION
# =============================================================================

# Relay server port (host mapping)
RELAY_PORT=8787

# Gateway URL (internal Docker network)
RELAY_GATEWAY_URL=http://gateway:8788/gateway

# CORS origins (comma-separated)
RELAY_ALLOWED_ORIGINS=https://localhost:3000,https://localhost:5173

# Security limits
RELAY_MAX_BODY_BYTES=1048576
RELAY_RATE_LIMIT=60

# Timeouts (milliseconds)
RELAY_CONNECT_TIMEOUT=3000
RELAY_TOTAL_TIMEOUT=15000

# Logging
RELAY_LOG_LEVEL=info
